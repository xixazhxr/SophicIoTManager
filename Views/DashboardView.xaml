<UserControl x:Class="SophicIoTManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#0D1B2A">

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryTextColor" Color="#E0E1DD"/>
        <SolidColorBrush x:Key="SecondaryTextColor" Color="#778DA9"/>
        <SolidColorBrush x:Key="AccentColor" Color="#00D9FF"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1B263B"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFD166"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#06D6A0"/>
        <SolidColorBrush x:Key="OfflineColor" Color="#8D99AE"/>

        <!-- Text Styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Status Indicator Styles -->
        <Style x:Key="StatusIndicator" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Device List Item Style -->
        <Style x:Key="DeviceListItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Log Entry Style -->
        <Style x:Key="LogEntry" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Sophie IoT Device Manager" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryTextColor}"/>
                <TextBlock Text="LobbyMAN Network Management Console" 
                           FontSize="13" 
                           Foreground="{StaticResource SecondaryTextColor}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stats Row -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Projects -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="2" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Projects" FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Gateways -->
                <Border Grid.Column="1" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="3" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gateways" FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Devices -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="6" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Devices" FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Online -->
                <Border Grid.Column="3" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="3" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Online" FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Offline -->
                <Border Grid.Column="4" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="2" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource OfflineColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Offline" FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Errors -->
                <Border Grid.Column="5" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="1" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource ErrorColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Errors" FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Three Columns with Adjusted Widths -->
            <Grid Grid.Row="2">
                <!-- Adjusted column widths: Left smaller, Middle wider, Right smaller -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>  <!-- Smaller -->
                    <ColumnDefinition Width="1.8*"/>  <!-- Wider -->
                    <ColumnDefinition Width="1.2*"/>  <!-- Smaller -->
                </Grid.ColumnDefinitions>

                <!-- Left Column: PROJECTS (Smaller) -->
                <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="PROJECTS"/>
                            
                            <!-- Smart Factory Floor -->
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Smart Factory Floor" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text=" (0 Device)" 
                                               Foreground="{StaticResource SecondaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Gateway-North -->
                                <StackPanel Style="{StaticResource DeviceListItem}">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource SuccessColor}"/>
                                    <TextBlock Text="Gateway-North • Online" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Temp-Sensor-01 -->
                                <StackPanel Style="{StaticResource DeviceListItem}" Margin="8,0,0,0">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource SuccessColor}"/>
                                    <TextBlock Text="Temp-Sensor-01 • Online" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Vibration-Monitor-01 -->
                                <StackPanel Style="{StaticResource DeviceListItem}" Margin="8,0,0,0">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource ErrorColor}"/>
                                    <TextBlock Text="Vibration-Monitor-01 ▲ Error" 
                                               Foreground="{StaticResource ErrorColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Gateway-South -->
                                <StackPanel Style="{StaticResource DeviceListItem}">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource SuccessColor}"/>
                                    <TextBlock Text="Gateway-South • Online" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Pressure-Gauge-01 -->
                                <StackPanel Style="{StaticResource DeviceListItem}" Margin="8,0,0,0">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource SuccessColor}"/>
                                    <TextBlock Text="Pressure-Gauge-01 • Online" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Humidity-Sensor-01 -->
                                <StackPanel Style="{StaticResource DeviceListItem}" Margin="8,0,0,0">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource OfflineColor}"/>
                                    <TextBlock Text="Humidity-Sensor-01 ○ Offline" 
                                               Foreground="{StaticResource OfflineColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Standalone-Temp-01 -->
                                <StackPanel Style="{StaticResource DeviceListItem}" Margin="8,0,0,0">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource SuccessColor}"/>
                                    <TextBlock Text="Standalone-Temp-01 • Online" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Separator -->
                            <Border Height="1" Background="#2C3E50" Margin="0,8,0,12"/>

                            <!-- Warehouse Monitoring -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Warehouse Monitoring" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text=" (0 Device)" 
                                               Foreground="{StaticResource SecondaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Gateway-Warehouse -->
                                <StackPanel Style="{StaticResource DeviceListItem}">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource OfflineColor}"/>
                                    <TextBlock Text="Gateway-Warehouse ○ Offline" 
                                               Foreground="{StaticResource OfflineColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                
                                <!-- Temp-WH-01 -->
                                <StackPanel Style="{StaticResource DeviceListItem}" Margin="8,0,0,0">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource OfflineColor}"/>
                                    <TextBlock Text="Temp-WH-01 ○ Offline" 
                                               Foreground="{StaticResource OfflineColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick Add Section -->
                            <Border Height="1" Background="#2C3E50" Margin="0,16,0,12"/>
                            <StackPanel>
                                <TextBlock Text="QUICK ADD" 
                                           Foreground="{StaticResource SecondaryTextColor}" 
                                           FontSize="11"
                                           Margin="0,0,0,8"/>
                                <StackPanel Style="{StaticResource DeviceListItem}">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#778DA9" Margin="0,0,8,0"/>
                                    <TextBlock Text="Gateway" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource DeviceListItem}">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#778DA9" Margin="0,0,8,0"/>
                                    <TextBlock Text="Device" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Middle Column: Dashboard & Charts (Wider) -->
                <Grid Grid.Column="1" Margin="8,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DASHBOARD Title -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <TextBlock Text="DASHBOARD" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryTextColor}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Device Status Distribution (Restored) -->
                    <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Device Status Distribution"/>
                            
                            <lvc:PieChart Grid.Row="1" 
                                          Height="140"
                                          Series="{Binding StatusPieSeries}"
                                          InitialRotation="-90"
                                          LegendPosition="Hidden"
                                          VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource SuccessColor}"/>
                                    <TextBlock Text="Operating" Foreground="{StaticResource PrimaryTextColor}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource OfflineColor}"/>
                                    <TextBlock Text="Offline" Foreground="{StaticResource PrimaryTextColor}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusIndicator}" Background="{StaticResource ErrorColor}"/>
                                    <TextBlock Text="Error" Foreground="{StaticResource PrimaryTextColor}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Charts Section -->
                    <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Devices per Project"/>
                            
                            <!-- Project List (Expanded) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="220" Margin="0,8,0,4">
                                <ItemsControl ItemsSource="{Binding ProjectsCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" 
                                                           Foreground="{StaticResource PrimaryTextColor}" 
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text=": " 
                                                           Foreground="{StaticResource SecondaryTextColor}"/>
                                                <TextBlock Text="{Binding Devices.Count}" 
                                                           Foreground="{StaticResource AccentColor}" 
                                                           FontSize="13"/>
                                                <TextBlock Text=" Device(s)" 
                                                           Foreground="{StaticResource SecondaryTextColor}" 
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Column: DETAILS (Smaller) -->
                <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Margin="8,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="DETAILS"/>
                            
                            <!-- Selection Details -->
                            <Border Background="#2C3E50" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItemName}" 
                                               Foreground="{StaticResource PrimaryTextColor}" 
                                               FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedItemType}" 
                                               Foreground="{StaticResource AccentColor}" 
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding SelectedItemType, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding SelectedItemDetails}" 
                                               Foreground="{StaticResource SecondaryTextColor}" 
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- SYSTEM LOGS Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="SYSTEM LOGS" 
                                           Style="{StaticResource SubHeaderText}"/>
                                <Border Background="#2C3E50" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding LogEntries.Count, StringFormat='({0})'}" 
                                               Foreground="{StaticResource SecondaryTextColor}" 
                                               FontSize="11"/>
                                </Border>
                            </StackPanel>

                            <!-- Log Entries (Dynamic) -->
                            <ItemsControl ItemsSource="{Binding LogEntries}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Style="{StaticResource LogEntry}">
                                            <TextBlock Text="{Binding Timestamp}" 
                                                       Foreground="{StaticResource SecondaryTextColor}" 
                                                       FontSize="11" 
                                                       Width="55"/>
                                            <TextBlock Text="{Binding Level}" 
                                                       Foreground="{Binding LevelColor}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       Width="50"
                                                       Margin="4,0,4,0"/>
                                            <TextBlock Text="{Binding Message}" 
                                                       Foreground="{StaticResource PrimaryTextColor}" 
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Simulation Running Indicator (Dynamic) -->
                            <Border CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1C392C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulationRunning}" Value="False">
                                                <Setter Property="Background" Value="#2C3E50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSimulationRunning}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource OfflineColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Simulation Running"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSimulationRunning}" Value="False">
                                                        <Setter Property="Text" Value="Simulation Stopped"/>
                                                        <Setter Property="Foreground" Value="{StaticResource OfflineColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>