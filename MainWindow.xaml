<Window x:Class="SophicIoTManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SophicIoTManager"
        xmlns:vm="clr-namespace:SophicIoTManager.ViewModels"
        xmlns:views="clr-namespace:SophicIoTManager.Views"
        mc:Ignorable="d"
        Title="Sophic IoT Device Manager" 
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D1B2A">

    <Window.Resources>
        <!-- Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        
        <!-- Color Palette - Professional Dark Theme -->
        <SolidColorBrush x:Key="BgDark" Color="#0D1B2A"/>
        <SolidColorBrush x:Key="BgMedium" Color="#1B263B"/>
        <SolidColorBrush x:Key="BgLight" Color="#415A77"/>
        <SolidColorBrush x:Key="Accent" Color="#00D9FF"/>
        <SolidColorBrush x:Key="AccentDark" Color="#0077B6"/>
        <SolidColorBrush x:Key="Success" Color="#00E676"/>
        <SolidColorBrush x:Key="Warning" Color="#FFB300"/>
        <SolidColorBrush x:Key="Error" Color="#FF5252"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E1DD"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#778DA9"/>
        <SolidColorBrush x:Key="Border" Color="#415A77"/>

        <!-- Button Styles -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
            <Setter Property="Foreground" Value="#0D1B2A"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource Error}"/>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource BgLight}"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TreeView Item Style -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDark}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Expander Style for Dark Theme -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgMedium}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Sophic IoT Device Manager" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="LoRaWAN Network Management Console" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Success}" CornerRadius="4" Padding="12,6" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● Online: " Foreground="#0D1B2A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OnlineDeviceCount}" Foreground="#0D1B2A" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgLight}" CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 Total: " Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalDeviceCount}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ToggleSimulationCommand}" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                <Setter Property="Content" Value="▶ Start Sim"/>
                                <Setter Property="Background" Value="{StaticResource Success}"/>
                                <Setter Property="Foreground" Value="#0D1B2A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulationRunning}" Value="True">
                                        <Setter Property="Content" Value="⏸ Stop Sim"/>
                                        <Setter Property="Background" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource BgMedium}" Margin="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgDark}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="PROJECTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Width="160" Margin="0,0,8,0"
                                         ToolTip="New project name"/>
                                <Button Content="+ Add" Command="{Binding AddProjectCommand}" Style="{StaticResource BtnSuccess}" Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TreeView -->
                    <TreeView Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="8"
                              ItemsSource="{Binding Projects}" 
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- Context Menu for Project -->
                            <ContextMenu x:Key="ProjectContextMenu">
                                <MenuItem Header="➕ Add Gateway" 
                                          Command="{Binding PlacementTarget.Tag.AddGatewayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="➕ Add Device" 
                                          Command="{Binding PlacementTarget.Tag.AddDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="✏️ Edit Project" 
                                          Command="{Binding PlacementTarget.Tag.EditProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="🗑️ Delete Project" 
                                          Command="{Binding PlacementTarget.Tag.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>

                            <!-- Context Menu for Gateway -->
                            <ContextMenu x:Key="GatewayContextMenu">
                                <MenuItem Header="➕ Add Device" 
                                          Command="{Binding PlacementTarget.Tag.AddDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="✏️ Edit Gateway" 
                                          Command="{Binding PlacementTarget.Tag.EditGatewayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="🔌 Toggle Status" 
                                          Command="{Binding PlacementTarget.Tag.ToggleGatewayStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="🗑️ Delete Gateway" 
                                          Command="{Binding PlacementTarget.Tag.DeleteGatewayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>

                            <!-- Context Menu for Device -->
                            <ContextMenu x:Key="DeviceContextMenu">
                                <MenuItem Header="✏️ Edit Device" 
                                          Command="{Binding PlacementTarget.Tag.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="🔌 Toggle Status" 
                                          Command="{Binding PlacementTarget.Tag.ToggleDeviceStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="🗑️ Delete Device" 
                                          Command="{Binding PlacementTarget.Tag.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>

                            <!-- Project Template -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:ProjectViewModel}" ItemsSource="{Binding Children}">
                                <Grid x:Name="ProjectItem" ContextMenu="{StaticResource ProjectContextMenu}"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding DeviceCountDisplay, StringFormat=' ({0})'}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⋮" 
                                            Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                            BorderThickness="0" FontSize="16" Padding="8,2" Cursor="Hand"
                                            ToolTip="Actions" Visibility="Hidden"
                                            Click="FabButton_Click"/>
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                        <Setter TargetName="ProjectItem" Property="Tag" Value="Visible"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>

                            <!-- Gateway Template -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:GatewayViewModel}" ItemsSource="{Binding Devices}">
                                <Grid x:Name="GatewayItem" ContextMenu="{StaticResource GatewayContextMenu}"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="📡" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{Binding StatusColor}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⋮" 
                                            Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                            BorderThickness="0" FontSize="16" Padding="8,2" Cursor="Hand"
                                            ToolTip="Actions" Visibility="Hidden"
                                            Click="FabButton_Click"/>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <!-- Device Template -->
                            <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                                <Grid x:Name="DeviceItem" ContextMenu="{StaticResource DeviceContextMenu}"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="📱" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{Binding StatusColor}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⋮" 
                                            Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                            BorderThickness="0" FontSize="16" Padding="8,2" Cursor="Hand"
                                            ToolTip="Actions" Visibility="Hidden"
                                            Click="FabButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                        
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- Quick Actions -->
                    <Border Grid.Row="2" Background="{StaticResource BgDark}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="QUICK ADD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ Gateway" Command="{Binding AddGatewayCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,4,0" Padding="8,6"/>
                                <Button Grid.Column="1" Content="+ Device" Command="{Binding AddDeviceCommand}" Style="{StaticResource BtnSecondary}" Margin="4,0,0,0" Padding="8,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Detail Panel with Collapsible Sections -->
            <Border Grid.Column="1" Background="{StaticResource BgDark}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        
                        <!-- DASHBOARD Section (Collapsible) -->
                        <Expander IsExpanded="{Binding IsDashboardExpanded}" Margin="0,0,0,16">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="DASHBOARD" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                                <views:DashboardView DataContext="{Binding Dashboard}" Height="480"/>
                            </Border>
                        </Expander>

                        <!-- PROJECTS / DETAILS Section (Collapsible) -->
                        <Expander IsExpanded="{Binding IsProjectsExpanded}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="DETAILS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Project Detail View -->
                                    <StackPanel Visibility="{Binding SelectedProject, Converter={StaticResource NotNullToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock Text="PROJECT DETAILS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <Button Content="✏️ Edit" Command="{Binding EditSelectedItemCommand}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Padding="12,4"/>
                                        </Grid>
                                        
                                        <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedProject.Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding SelectedProject.Description}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding SelectedProject.CreatedAtDisplay, StringFormat='Created: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <Button Content="🗑 Delete Project" Command="{Binding DeleteProjectCommand}" Style="{StaticResource BtnDanger}" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <!-- Gateway Detail View -->
                                    <StackPanel Visibility="{Binding SelectedGateway, Converter={StaticResource NotNullToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock Text="GATEWAY DETAILS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <Button Content="✏️ Edit" Command="{Binding EditSelectedItemCommand}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Padding="12,4"/>
                                        </Grid>
                                        
                                        <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedGateway.Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gateway EUI:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGateway.GatewayEUI}" Foreground="{StaticResource Accent}" FontFamily="Consolas" Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Location:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGateway.Location}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Frequency:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedGateway.FrequencyBand}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGateway.StatusDisplay}" Foreground="{Binding SelectedGateway.StatusColor}" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🔌 Toggle Status" Command="{Binding ToggleGatewayStatusCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                            <Button Content="🗑 Delete Gateway" Command="{Binding DeleteGatewayCommand}" Style="{StaticResource BtnDanger}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Device Detail View -->
                                    <StackPanel Visibility="{Binding SelectedDevice, Converter={StaticResource NotNullToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock Text="DEVICE DETAILS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <Button Content="✏️ Edit" Command="{Binding EditSelectedItemCommand}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Padding="12,4"/>
                                        </Grid>
                                        
                                        <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.TypeDisplay}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.StatusDisplay}" Foreground="{Binding SelectedDevice.StatusColor}" FontWeight="Bold" Margin="0,0,0,12"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Value:" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.ValueDisplay}" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>

                                        <!-- LoRaWAN Info -->
                                        <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="LoRaWAN Settings" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DevEUI:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.DevEUI}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="JoinEUI:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.JoinEUI}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="AppKey:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.AppKey}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Activation:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.ActivationModeDisplay}" Foreground="{StaticResource TextPrimary}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🔌 Toggle Status" Command="{Binding ToggleDeviceStatusCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                            <Button Content="🗑 Delete Device" Command="{Binding DeleteDeviceCommand}" Style="{StaticResource BtnDanger}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- No Selection -->
                                    <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}">
                                        <TextBlock Text="Select a project, gateway, or device from the sidebar to view details." 
                                                   Foreground="{StaticResource TextSecondary}" FontSize="14" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Logs Header -->
        <Border Grid.Row="2" Background="{StaticResource BgMedium}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋 SYSTEM LOGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding SystemLogs.Count, StringFormat=' ({0})'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource BtnSecondary}" Padding="12,4"/>
            </Grid>
        </Border>

        <!-- Logs Panel -->
        <Border Grid.Row="3" Background="{StaticResource BgDark}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl ItemsSource="{Binding SystemLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" Margin="0,1" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding LevelColor}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource BgMedium}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Sophic Automation © 2026" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
            </Grid>
        </Border>

        <!-- Edit Modal Overlay (positioned above everything) -->
        <views:EditModal Grid.RowSpan="5" DataContext="{Binding EditModal}" Panel.ZIndex="100"/>
    </Grid>
</Window>
